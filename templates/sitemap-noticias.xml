<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
{% for a in lista %}
  <url>
    <loc>{{ cfg.url }}{{ a.url }}</loc>
    <news:news>
      <news:publication><news:name>NewTimes.news</news:name><news:language>{{ ed.idioma[:2] }}</news:language></news:publication>
      <news:publication_date>{{ a.fecha_iso }}</news:publication_date>
      <news:title>{{ a.titulo }}</news:title>
    </news:news>
  </url>
{% endfor %}
</urlset>
