[Unit]
Description=NewTimes.news: redactor autónomo en español, cada hora entre los turnos del jefe de redacción

[Timer]
# El jefe de redacción (Claude) deja encargos a las 9:06, 12:06, 15:06, 18:06 y 21:06 y el servidor los
# publica hacia las :15. El redactor autónomo sale a las :20, cuando ya están publicados, para no repetir
# temas. La edición en inglés sale a las :35. Madrugada: cada 3 horas.
OnCalendar=*-*-* 07..23:20:00 Europe/Madrid
OnCalendar=*-*-* 00..06/3:20:00 Europe/Madrid
Persistent=false

[Install]
WantedBy=timers.target
